---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }} — {{ site.tagline }}</title>
    <description>{{ site.description | strip_newlines | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <language>pl-PL</language>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {%- if site.posts.first %}
    <lastBuildDate>{{ site.posts.first.date | date_to_rfc822 }}</lastBuildDate>
    {%- endif %}

    {%- for post in site.posts limit: 25 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <description>{% if post.summary %}{{ post.summary | xml_escape }}{% else %}{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}{% endif %}</description>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {%- for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}

  </channel>
</rss>
